CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m_c3.csv"
CONFIG_SR_WN_WN9S_NIHAOXIAOZHI=y

# 唤醒词：C3 支持 Wakenet9（无 AFE），"你好小智" 本地识别
# 不开这个，assets 打包脚本会跳过模型 → wake_word_=nullptr → 喊不醒
CONFIG_USE_ESP_WAKE_WORD=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=768
CONFIG_LWIP_IPV6=n

# 启用 httpd 的 WebSocket 服务端支持（用于取代 100ms HTTP 轮询）
# 不开这个 httpd_ws_send_frame_async 等 API 不存在 → 编译失败
CONFIG_HTTPD_WS_SUPPORT=y

# ── 板型：WHA103 = xmini-c3 公版硬件 ────────────────────────────
#   COM9 设备实测：ESP32-C3 + 16MB Flash + ES8311 + SSD1306 0.96"
#   分区表 16m_c3 与原厂固件逐字节一致（ota_0@0x20000 / ota_1@0x410000 / assets@0x800000）
CONFIG_BOARD_TYPE_XMINI_C3=y
